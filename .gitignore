# Python
.venv/
__pycache__/
*.py[cod]
*.pyd
*.pyo
*.egg-info/
dist/
build/

# Large/derived data (keep folder structure via .gitkeep)
ontology_cf_anomaly/data/**
!ontology_cf_anomaly/data/**/.gitkeep
ontology_cf_anomaly/ontologies/**
!ontology_cf_anomaly/ontologies/**/.gitkeep

# Generated ontology artifacts (large)
ontologies/processed/*.gpickle
ontologies/processed/*.csv

# Raw licensed ontology downloads + extracted RF2/RRF (UMLS/SNOMED/RxNorm/ICD).
# License-restricted: must NOT be committed or redistributed.
ontologies/raw/

# Derived ontology maps embed licensed SNOMED/UMLS/RxNorm content -> do not commit.
# (The small provenance manifest is allowed; it contains only counts + hashes.)
ontologies/processed/*.json
ontologies/processed/*.txt
!ontologies/processed/ontology_asset_manifest.json
!ontologies/processed/.gitkeep

# Training outputs
checkpoints/
logs/

# Your local research folders
Datasets/
PapersPDF/
Literature/

# Backups
*.bak_*

# Local-only stuff
_local/
one_pagers/

# Ignore sibling project folders
RiNALMo/

# Generated data / local artifacts
data/processed/
*.parquet
*.pkl
dataset_roots.env
mimiciii_header_report.json

# IDE
.idea/

# Local/generated development files
.claude/
outputs/

# Generated tensor/checkpoint artifacts
*.pt
*.pth
*.ckpt

# Regenerable smoke-detector training outputs (incl. MIMIC-derived vocab) — not committed
artifacts/phase3/detector_unsup_v2/

# Phase 5: per-record MIMIC-derived scores (s_gen/s_ont/s_det per record) — not committed
artifacts/phase5/per_record_scores.csv

# Phase 6: training runs — checkpoints / vocab / per-record scores are MIMIC-derived.
# Aggregate run JSON/MD/CSV summaries ARE committed; the heavy/PHI-derived parts are not.
artifacts/phase6/runs/*/checkpoints/
artifacts/phase6/runs/*/vocab/
artifacts/phase6/runs/*/ignored/
artifacts/phase6/**/*.pt
artifacts/phase6/**/*.pth
artifacts/phase6/**/*.pkl
artifacts/phase6/**/*.parquet
artifacts/phase6/**/per_record*

# Phase 7: final evaluation — only aggregate tables/JSON/MD/figure-data are committed.
artifacts/phase7/ignored/
artifacts/phase7/**/per_record*
artifacts/phase7/**/*.pkl
artifacts/phase7/**/*.pt
artifacts/phase7/**/*.parquet
artifacts/phase7/**/*.zip

# Large generated evaluation artifacts
artifacts/day36/counterfactuals.csv
artifacts/day36_repair_ready/repair_ready_scores.csv
artifacts/day36_probe/
artifacts/day36_probe_v2/
artifacts/day36_probe_v3/

# Profiling binaries
artifacts/day43/*.prof

# --- Phase 8 hardening: global restricted-data guards ---
# Belt-and-braces patterns so restricted/derived material can never be committed under
# any artifacts/phase*/ directory (aggregate JSON/MD/CSV/PNG summaries remain allowed).
*.zip
artifacts/**/per_record*
artifacts/**/checkpoints/
artifacts/**/vocab/
artifacts/**/ignored/
artifacts/phase8/ignored/
